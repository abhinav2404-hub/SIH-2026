# Mudra Check Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Local or Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mudra_check?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/mudra_check

# Security & JWT Tokens
JWT_SECRET=mudra_check_secure_jwt_secret_token_2026_xyz
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=mudra_check_secure_refresh_secret_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# Shared Inspector API Key (Prototype Fallback)
API_KEY=MUDRA_INSPECTOR_LIVE_KEY_8842

# AI Services (Server-Side Only - Never Expose to Mobile App)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS & Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
STORAGE_PROVIDER=local
